{
  "extraKnownMarketplaces": {
    "claude-rules": {
      "source": {
        "source": "github",
        "repo": "bogheorghiu/shared-rules"
      }
    },
    "prompt-design": {
      "source": {
        "source": "github",
        "repo": "bogheorghiu/prompt-design"
      }
    }
  },
  "enabledPlugins": {
    "shared-rules@claude-rules": true,
    "prompt-design@prompt-design": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 .github/scripts/sync_manifests.py >&2 || true"
          }
        ]
      }
    ]
  }
}
